{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private encrypted PostgreSQL and one-off restricted-user bootstrap, no master credential on API",
  "Parameters": {
    "DatabaseSubnets": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "DbSG": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "ImageUri": {
      "Type": "String"
    },
    "EngineVersion": {
      "Type": "String",
      "Description": "An available, supported PostgreSQL version, checked with describe-db-engine-versions"
    },
    "MultiAZ": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": ["true", "false"]
    },
    "ProtectDatabase": {
      "Type": "String",
      "Default": "true",
      "AllowedValues": ["true", "false"]
    },
    "RepositoryArn": {
      "Type": "String",
      "Description": "Only the lab ECR repository ARN"
    }
  },
  "Resources": {
    "SubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Private database subnets in two AZs",
        "SubnetIds": {
          "Ref": "DatabaseSubnets"
        }
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "EngineVersion"
        },
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "MaxAllocatedStorage": 100,
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "DBName": "lab",
        "MasterUsername": "labadmin",
        "ManageMasterUserPassword": true,
        "BackupRetentionPeriod": 7,
        "PubliclyAccessible": false,
        "MultiAZ": {
          "Fn::If": ["UseMultiAZ", true, false]
        },
        "DeletionProtection": {
          "Fn::If": ["Protect", true, false]
        },
        "DBSubnetGroupName": {
          "Ref": "SubnetGroup"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DbSG"
          }
        ],
        "AutoMinorVersionUpgrade": true
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "AppSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Lab restricted SQL user. Rotation must update DB password and replace API tasks.",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"lab_reader\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "InitLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 7
      }
    },
    "InitRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "BootstrapOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Ref": "RepositoryArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": {
                    "Fn::GetAtt": ["InitLogs", "Arn"]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": [
                    {
                      "Fn::GetAtt": ["Database", "MasterUserSecret.SecretArn"]
                    },
                    {
                      "Ref": "AppSecret"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "InitTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": ["InitRole", "Arn"]
        },
        "ContainerDefinitions": [
          {
            "Name": "init",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "ReadonlyRootFilesystem": true,
            "Command": ["python", "db_init.py"],
            "Environment": [
              {
                "Name": "PGHOST",
                "Value": {
                  "Fn::GetAtt": ["Database", "Endpoint.Address"]
                }
              },
              {
                "Name": "PGDATABASE",
                "Value": "lab"
              }
            ],
            "Secrets": [
              {
                "Name": "MASTER_SECRET",
                "ValueFrom": {
                  "Fn::GetAtt": ["Database", "MasterUserSecret.SecretArn"]
                }
              },
              {
                "Name": "DB_SECRET",
                "ValueFrom": {
                  "Ref": "AppSecret"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "InitLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "init"
              }
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "DbId": {
      "Value": {
        "Ref": "Database"
      }
    },
    "DbHost": {
      "Value": {
        "Fn::GetAtt": ["Database", "Endpoint.Address"]
      }
    },
    "DbSecretArn": {
      "Value": {
        "Ref": "AppSecret"
      }
    },
    "DbSubnetGroup": {
      "Value": {
        "Ref": "SubnetGroup"
      }
    },
    "InitTask": {
      "Value": {
        "Ref": "InitTask"
      }
    },
    "InitLogGroup": {
      "Value": {
        "Ref": "InitLogs"
      }
    }
  },
  "Conditions": {
    "UseMultiAZ": {
      "Fn::Equals": [
        {
          "Ref": "MultiAZ"
        },
        "true"
      ]
    },
    "Protect": {
      "Fn::Equals": [
        {
          "Ref": "ProtectDatabase"
        },
        "true"
      ]
    }
  }
}
